# =============================================================================
# Translation App — backend environment configuration
# Copy to: /home/sw/translation_app/backend/.env
# Permissions after copy: chmod 600 .env
# Never commit this file with real values.
# =============================================================================

# -- Google Cloud -------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=/home/sw/translation_app/backend/config/service-account-credentials.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# -- Server -------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000

# -- Paths --------------------------------------------------------------------
DATA_DIR=/home/sw/translation_app/backend/data
STATIC_DIR=/home/sw/translation_app/backend/static

# -- CORS ---------------------------------------------------------------------
# HTTP phase (before certbot):
CORS_ALLOWED_ORIGINS=http://translate.streamworks.no
# After HTTPS is live, change to:
# CORS_ALLOWED_ORIGINS=https://translate.streamworks.no

# -- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO

# -- PostgreSQL (not yet wired to app — ready for Phase 2) --------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=translation_app
POSTGRES_USER=translation_app
POSTGRES_PASSWORD=CHANGE_TO_STRONG_PASSWORD
DATABASE_URL=postgresql://translation_app:CHANGE_TO_STRONG_PASSWORD@localhost:5432/translation_app
